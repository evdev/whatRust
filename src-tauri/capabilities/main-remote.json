{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-remote",
  "description": "What the remote WhatsApp Web page may call through bridge.js: notifications, the unread count, diagnostic breadcrumbs and the download toast's Open/Show buttons, and the clipboard files or image for a paste WebKitGTK hid from the page (clipboard.rs). core:default is intentionally NOT granted so the remote origin cannot emit/listen on internal event channels or introspect the app, and of the notification plugin only its read-only permission query is granted: its init script asks it on every page load (refused, that logged an unhandled rejection), while its `notify` would bypass the lock-aware `notify` and stays denied.",
  "remote": {
    "urls": [
      "https://web.whatsapp.com/*"
    ]
  },
  "permissions": [
    "allow-notify",
    "allow-notification-icon",
    "allow-set-notification-privacy",
    "allow-set-unread",
    "allow-dlog",
    "allow-open-download",
    "allow-reveal-download",
    "allow-switcher-accounts",
    "allow-switch-account",
    "allow-reload-account-page",
    "allow-zoom-step",
    "allow-paste-clipboard",
    "notification:allow-is-permission-granted",
    "allow-integration-state",
    "allow-report-integration",
    "allow-report-message-signal",
    "allow-open-app-panel",
    "allow-voice-prefs",
    "allow-voice-lookup",
    "allow-transcribe-voice",
    "allow-transcribe-video",
    "allow-summarize-voice",
    "allow-voice-transcripts",
    "allow-chat-summary-consent",
    "allow-summarize-chat",
    "allow-chat-summary-save",
    "allow-chat-summaries",
    "allow-chat-summary-delete",
    "allow-todo-list",
    "allow-todo-add",
    "allow-todo-star-state",
    "allow-todo-update",
    "allow-todo-toggle-done",
    "allow-todo-delete",
    "allow-todo-snooze",
    "allow-todo-dismiss-alarm",
    "allow-todo-clear-done",
    "allow-schedule-snapshot",
    "allow-schedule-save",
    "allow-schedule-cancel",
    "allow-schedule-decide",
    "allow-schedule-stage-begin",
    "allow-schedule-stage-chunk",
    "allow-schedule-stage-discard",
    "allow-schedule-report",
    "allow-schedule-delivery-chunk",
    "allow-schedule-delivery-prepare",
    "allow-schedule-delivery-result",
    "allow-autoreply-state",
    "allow-autoreply-set-chat",
    "allow-autoreply-set-access",
    "allow-autoreply-set-reply-mode",
    "allow-autoreply-get-chat-doc",
    "allow-autoreply-save-chat-doc",
    "allow-autoreply-reset-chat-doc",
    "allow-autoreply-open-chat-doc",
    "allow-autoreply-turn",
    "allow-autoreply-record-sent",
    "allow-autoreply-record-outside-hours",
    "allow-autoreply-pause-self",
    "allow-mention-event",
    "allow-mention-sent",
    "allow-mention-chat-action-done",
    "allow-mention-settled",
    "allow-mention-filter",
    "allow-mention-media",
    "allow-mention-heard"
  ],
  "webviews": [
    "wa-*"
  ]
}
