{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-remote",
  "description": "What the remote WhatsApp Web page may call through bridge.js: notifications, the unread count, diagnostic breadcrumbs and the download toast's Open/Show buttons. core:default is intentionally NOT granted so the remote origin cannot emit/listen on internal event channels or introspect the app, and of the notification plugin only its read-only permission query is granted: its init script asks it on every page load (refused, that logged an unhandled rejection), while its `notify` would bypass the lock-aware `notify` and stays denied.",
  "remote": {
    "urls": [
      "https://web.whatsapp.com/*"
    ]
  },
  "permissions": [
    "allow-notify",
    "allow-notification-icon",
    "allow-set-unread",
    "allow-dlog",
    "allow-open-download",
    "allow-reveal-download",
    "allow-switcher-accounts",
    "allow-switch-account",
    "allow-zoom-step",
    "notification:allow-is-permission-granted",
    "allow-integration-state",
    "allow-report-integration",
    "allow-report-message-signal",
    "allow-open-app-panel",
    "allow-voice-prefs",
    "allow-voice-lookup",
    "allow-transcribe-voice",
    "allow-summarize-voice",
    "allow-voice-transcripts",
    "allow-chat-summary-consent",
    "allow-summarize-chat",
    "allow-chat-summaries",
    "allow-chat-summary-delete",
    "allow-todo-list",
    "allow-todo-add",
    "allow-todo-update",
    "allow-todo-toggle-done",
    "allow-todo-delete",
    "allow-todo-snooze",
    "allow-todo-dismiss-alarm",
    "allow-todo-clear-done",
    "allow-autoreply-state",
    "allow-autoreply-set-chat",
    "allow-autoreply-get-chat-doc",
    "allow-autoreply-save-chat-doc",
    "allow-autoreply-reset-chat-doc",
    "allow-autoreply-open-chat-doc",
    "allow-autoreply-turn",
    "allow-autoreply-record-sent",
    "allow-autoreply-pause-self"
  ],
  "webviews": [
    "wa-*"
  ]
}
